+type compiledPattern struct {
+	kw   string
+	re   *regexp.Regexp
+	fast string
+}
+
+func procesarArchivo(path string, cfg BuscadorGlobalConfig, patterns []compiledPattern) ([]ResultBlock, map[string]bool) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, nil
+	}
+	defer f.Close()
+
+	keywordsFound := make(map[string]bool)
+	var blocks []ResultBlock
+	var currentBlock *ResultBlock
+	var ctxBefore []LineInfo
+	lastMatchLine := -cfg.ContextLines - cfg.GroupThreshold - cfg.ContextLines - 1
+	postCtxRemaining := 0
+
+	scanner := bufio.NewScanner(f)
+	buf := make([]byte, 0, 64*1024)
+	scanner.Buffer(buf, 1024*1024) // Max 1MB per line
+
+	lineNum := 0
+	for scanner.Scan() {
+		lineNum++
+		line := strings.TrimRight(scanner.Text(), "\r")
+
+		var matchedKws []string
+		lineForCheck := line
+		if !cfg.CaseSensitive {
+			lineForCheck = strings.ToLower(line)
+		}
+
+		for _, p := range patterns {
+			isMatch := false
+			if p.fast != "" {
+				if strings.Contains(lineForCheck, p.fast) {
+					isMatch = p.re.MatchString(line)
+				}
+			} else {
+				isMatch = p.re.MatchString(line)
+			}
+			if isMatch {
+				matchedKws = append(matchedKws, p.kw)
+				keywordsFound[p.kw] = true
+			}
+		}
+
+		li := LineInfo{LineNum: lineNum, Content: line, IsMatch: len(matchedKws) > 0, Keywords: matchedKws}
+
+		if len(matchedKws) > 0 {
+			dist := lineNum - lastMatchLine
+			if currentBlock != nil && dist-2*cfg.ContextLines <= cfg.GroupThreshold {
+				currentBlock.Lines = append(currentBlock.Lines, ctxBefore...)
+				currentBlock.Lines = append(currentBlock.Lines, li)
+				ctxBefore = nil
+			} else {
+				if currentBlock != nil {
+					blocks = append(blocks, *currentBlock)
+				}
+				currentBlock = &ResultBlock{File: path, HasGap: len(blocks) > 0}
+				currentBlock.Lines = append(currentBlock.Lines, ctxBefore...)
+				currentBlock.Lines = append(currentBlock.Lines, li)
+				ctxBefore = nil
+			}
+			lastMatchLine = lineNum
+			postCtxRemaining = cfg.ContextLines
+		} else {
+			if postCtxRemaining > 0 {
+				currentBlock.Lines = append(currentBlock.Lines, li)
+				postCtxRemaining--
+			} else {
+				ctxBefore = append(ctxBefore, li)
+				if len(ctxBefore) > cfg.ContextLines {
+					ctxBefore = ctxBefore[1:]
+				}
+			}
+		}
+	}
+
+	if currentBlock != nil {
+		blocks = append(blocks, *currentBlock)
+	}
+
+	return blocks, keywordsFound
+}
